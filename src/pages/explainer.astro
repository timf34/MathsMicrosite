---
import Layout from '../layouts/Layout.astro';
import EssayWave from '../components/EssayWave.astro';
import { Content, getHeadings } from '../content/Maths curriculum.md';
const headings = getHeadings().filter(heading => heading.depth > 1 && heading.slug !== 'footnote-label');
---
<Layout title="Leaving Cert maths reform explained — Save Maths" description="Why the proposed Leaving Cert maths specification raises concerns about assessment, mathematical content and standards. Read the full explainer and appendix.">
  <a class="skip-link" href="#essay">Skip to the essay</a>
  <div class="essay-controls">
    <details class="essay-menu" id="essay-menu">
      <summary aria-label="Open section menu" title="Open section menu"><span class="burger" aria-hidden="true"><span></span><span></span><span></span></span></summary>
      <nav aria-label="Essay sections">
        <ul>{headings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}<li><a href="#footnote-label">Footnotes</a></li></ul>
      </nav>
    </details>
    <a class="essay-home" href="/" aria-label="Back to the open letter">← <span class="home-desktop">Open letter</span><span class="home-mobile">Back to the open letter</span></a>
  </div>
  <main class="essay-main" id="essay">
    <article class="essay-body"><Content /></article>
  </main>
  <EssayWave />
</Layout>
<script>
  const appendixHeading = document.getElementById('appendix-mathematical-errors-in-the-draft-specification');
  if (appendixHeading) {
    const disclosure = document.createElement('details');
    disclosure.className = 'essay-appendix';
    const summary = document.createElement('summary');
    const content = document.createElement('div');
    content.className = 'appendix-content';
    appendixHeading.before(disclosure);
    let sibling = appendixHeading.nextSibling;
    while (sibling && !(sibling instanceof Element && (sibling.matches('[data-footnotes]') || sibling.matches('h1, h2, h3')))) {
      const next = sibling.nextSibling;
      content.append(sibling);
      sibling = next;
    }
    summary.append(appendixHeading);
    disclosure.append(summary, content);
    const revealTarget = (hash: string) => {
      const target = document.getElementById(decodeURIComponent(hash.slice(1)));
      if (target && disclosure.contains(target)) disclosure.open = true;
    };
    document.addEventListener('click', event => {
      const link = event.target instanceof Element ? event.target.closest('a') : null;
      if (link && link.pathname === location.pathname && link.hash) revealTarget(link.hash);
    });
    window.addEventListener('hashchange', () => revealTarget(location.hash));
    // Start collapsed, including when reloading an appendix URL.
    // Deliberate in-page navigation still opens the relevant content.
    let openBeforePrint = false;
    window.addEventListener('beforeprint', () => { openBeforePrint = disclosure.open; disclosure.open = true; });
    window.addEventListener('afterprint', () => { disclosure.open = openBeforePrint; });
  }
  const menu = document.querySelector<HTMLDetailsElement>('#essay-menu')!;
  const trigger = menu.querySelector('summary')!;
  const links = [...menu.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
  const sections = links.map(link => ({
    link,
    heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
  })).filter(section => section.heading !== null);

  // Keep the last heading passed at the reading line active between sections.
  const updateCurrentSection = () => {
    const readingLine = Math.max(100, window.innerHeight * 0.25);
    let current: HTMLAnchorElement | undefined;
    for (const section of sections) {
      if (section.heading!.getBoundingClientRect().top <= readingLine) current = section.link;
      else break;
    }
    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
      current = sections.at(-1)?.link;
    }
    links.forEach(link => {
      if (link === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  let scrollFrame = 0;
  const scheduleUpdate = () => {
    if (scrollFrame) return;
    scrollFrame = requestAnimationFrame(() => {
      scrollFrame = 0;
      updateCurrentSection();
    });
  };
  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('resize', scheduleUpdate);
  window.addEventListener('hashchange', scheduleUpdate);
  window.addEventListener('pageshow', scheduleUpdate);
  // Images and font loading can move headings after the initial render.
  new ResizeObserver(scheduleUpdate).observe(document.querySelector('.essay-body')!);
  updateCurrentSection();

  const updateMenuLabel = () => {
    const label = menu.open ? 'Close section menu' : 'Open section menu';
    trigger.setAttribute('aria-label', label);
    trigger.setAttribute('title', label);
  };
  menu.addEventListener('toggle', updateMenuLabel);
  updateMenuLabel();
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu.open) { menu.open = false; trigger.focus(); }
  });
</script>
<style is:global>
  .essay-controls { position: fixed; top: 24px; left: 24px; right: 24px; display: flex; justify-content: space-between; align-items: start; z-index: 10; pointer-events: none; }
  .essay-controls > * { pointer-events: auto; }
  .essay-menu summary, .essay-home { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: var(--preview-ink); background-color: var(--preview-paper); background-image: var(--preview-texture); background-blend-mode: multiply; cursor: pointer; text-decoration: none; }
  .essay-menu summary { list-style: none; }
  .essay-menu summary::-webkit-details-marker { display: none; }
  .essay-menu summary:focus-visible { outline: 2px solid #000; outline-offset: 4px; }
  .burger { display: flex; flex-direction: column; gap: 5px; }
  .burger span { width: 23px; height: 2px; background: currentColor; transition: transform 180ms ease, opacity 180ms ease; }
  .essay-menu[open] .burger span:first-child { transform: translateY(7px) rotate(45deg); }
  .essay-menu[open] .burger span:nth-child(2) { opacity: 0; }
  .essay-menu[open] .burger span:last-child { transform: translateY(-7px) rotate(-45deg); }
  .essay-home { width: auto; padding: 0 12px; font-size: 15px; line-height: 1.4; }
  .home-mobile { display: none; }
  .essay-home { gap: 5px; }
  .essay-menu nav { position: absolute; top: 56px; left: 0; background-color: var(--preview-paper); background-image: var(--preview-texture); background-blend-mode: multiply; width: min(340px, calc(100vw - 48px)); padding: 8px 12px; max-height: calc(100dvh - 112px); overflow: auto; }
  .essay-menu nav { border: 1px solid rgb(89 96 99 / 25%); }
  .essay-menu ul { list-style: none; padding: 0; margin: 0; }
  .essay-menu a { display: block; padding: 10px 0; font-size: 16px; line-height: 1.45; text-decoration: none; color: #555; }
  .essay-menu a:hover { color: #000; }
  .essay-menu a[aria-current="location"] { font-weight: 700; color: #000; }
  .essay-menu[open] nav { animation: menu-appear 220ms ease-out; }
  @keyframes menu-appear { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .essay-menu[open] nav { animation: none; } .burger span { transition: none; } }
  @media (min-width: 768px) {
    .essay-controls { left: auto; justify-content: flex-end; gap: 8px; }
    .essay-home { order: -1; }
    .essay-menu nav { left: auto; right: 0; width: min(340px, var(--essay-sidebar-width, 300px)); }
  }
  .essay-main { width: min(720px, calc(100% - 48px)); margin: 0 auto; padding: 100px 0 80px; }
  .essay-body { margin: 0; overflow-wrap: break-word; }
  .essay-body h1 { font: 400 3.25rem/1.15 var(--serif); margin: 0 0 48px; text-wrap: balance; }
  .essay-body p, .essay-body li { font: 400 1.25rem/1.65 var(--serif); }
  .essay-body p { margin: 24px 0; }
  .essay-body h2, .essay-body h3 { font: 400 2rem/1.25 var(--serif); margin: 64px 0 24px; scroll-margin-top: 88px; }
  .essay-appendix { margin-top: 64px; }
  .essay-appendix summary { cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: 14px; }
  .essay-appendix summary::-webkit-details-marker { display: none; }
  .essay-appendix summary::after { content: '+'; font: 300 1.6rem/1 var(--serif); flex-shrink: 0; }
  .essay-appendix[open] summary::after { content: '−'; }
  .essay-appendix summary h3 { margin: 0; }
  .essay-appendix summary:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  .essay-body ul, .essay-body ol { padding-left: 1.5em; }
  .essay-body li { margin: 16px 0; padding-left: .25em; }
  .essay-body li p { margin: 12px 0; }
  .essay-body img { display: block; max-width: 100%; height: auto; margin: 32px auto; }
  .essay-body blockquote { margin: 32px 0; padding-left: 24px; border-left: 2px solid #000; }
  .essay-body :target { scroll-margin-top: 88px; }
  .essay-body [data-footnotes] { border-top: 1px solid #999; margin-top: 64px; padding-top: 16px; }
  .essay-body [data-footnotes] p, .essay-body [data-footnotes] li { font-size: 1rem; }
  .essay-body [data-footnotes] h2 { position: static; width: auto; height: auto; clip: auto; clip-path: none; overflow: visible; margin: 24px 0; font-size: 1.5rem; }
  @media(max-width: 767px) {
    .essay-controls {
      top: 0; left: 0; right: 0; height: 68px; padding: 12px;
      justify-content: space-between;
      background-color: var(--preview-paper);
      background-image: var(--preview-texture);
      background-blend-mode: multiply;
    }
    .essay-home { order: -1; padding: 0 8px; font-size: 13px; color: #596063; background: transparent; }
    .home-desktop { display: none; }
    .home-mobile { display: inline; }
    .essay-menu nav {
      position: fixed; top: 68px; bottom: 0; left: 0; right: 0;
      width: auto; max-height: none;
      padding: 12px 24px max(24px, env(safe-area-inset-bottom));
      overscroll-behavior: contain;
    }
    .essay-menu a { padding: 12px 0; }
    .essay-main { width: calc(100% - 40px); padding-top: 88px; }
    .essay-body h1 { font-size: 2.5rem; margin-bottom: 32px; }
    .essay-body p, .essay-body li { font-size: 1.125rem; }
    .essay-body h2, .essay-body h3 { font-size: 1.75rem; margin-top: 48px; }
  }
  @media print { .essay-controls { display: none; } .essay-main { width: 100%; padding: 0; } }
</style>
