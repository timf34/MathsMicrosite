---
interface Props { title?: string; }
const { title = 'A better standard for Leaving Cert maths — An open letter' } = Astro.props;
import '../styles/global.css';
import '../styles/design-variants.css';
import DesignSwitcher from '../components/DesignSwitcher.astro';
---
<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="An open letter on the future of Leaving Cert mathematics. Read the letter and explore the concerns about the draft specification." />
    <meta name="theme-color" content="#f1f1f1" />
    <title>{title}</title>
    <script is:inline>
      const previewDesign = new URL(window.location.href).searchParams.get('design');
      if (['original', 'white', 'paper'].includes(previewDesign)) {
        document.documentElement.dataset.design = previewDesign;
      }
    </script>
  </head>
  <body><slot /><DesignSwitcher /></body>
</html>
